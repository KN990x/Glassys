# Data directory (config.yaml, secrets.json, transcript, SDK store).
GLASSYS_DATA_DIR=./data

# Optional overrides. If unset, Glassys generates/stores these in $GLASSYS_DATA_DIR/secrets.json.
# GLASSYS_JWT_SECRET=
# GLASSYS_OPERATOR_PASSWORD_HASH=
# CURSOR_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# CODEX_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=

# Bind override (keep config.yaml bind, default 127.0.0.1, unless you mean to expose the port).
# GLASSYS_BIND=0.0.0.0
# GLASSYS_PORT=8787
